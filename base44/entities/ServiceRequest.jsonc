{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629/\u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "applicant_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0645\u0642\u062f\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "sector": {
      "type": "string",
      "enum": [
        "\u062a\u062c\u0627\u0631\u064a",
        "\u0635\u0646\u0627\u0639\u064a",
        "\u062a\u0642\u0646\u064a",
        "\u062e\u062f\u0645\u064a",
        "\u0632\u0631\u0627\u0639\u064a",
        "\u0635\u062d\u064a",
        "\u062a\u0639\u0644\u064a\u0645\u064a",
        "\u0633\u064a\u0627\u062d\u064a",
        "\u0639\u0642\u0627\u0631\u064a",
        "\u0623\u062e\u0631\u0649"
      ],
      "title": "\u0627\u0644\u0642\u0637\u0627\u0639"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "\u062a\u0623\u0633\u064a\u0633 \u0645\u0634\u0631\u0648\u0639 \u062c\u062f\u064a\u062f",
        "\u0627\u062d\u062a\u0636\u0627\u0646 \u0645\u0634\u0631\u0648\u0639 \u0642\u0627\u0626\u0645",
        "\u062f\u0631\u0627\u0633\u0629 \u062c\u062f\u0648\u0649",
        "\u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0625\u062f\u0627\u0631\u064a\u0629",
        "\u062a\u0633\u0639\u064a\u0631 \u0639\u0627\u0644\u0645\u064a",
        "\u062e\u062f\u0645\u0627\u062a \u062d\u0643\u0648\u0645\u064a\u0629"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "num_employees": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0642\u0639"
    },
    "estimated_budget": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u062a\u0642\u062f\u064a\u0631\u064a\u0629 (\u0631\u064a\u0627\u0644)"
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u062c\u062f\u064a\u062f",
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u0645\u0642\u0628\u0648\u0644",
        "\u0645\u0631\u0641\u0648\u0636",
        "\u0645\u0643\u062a\u0645\u0644"
      ],
      "default": "\u062c\u062f\u064a\u062f",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "automation_status": {
      "type": "string",
      "enum": [
        "\u0644\u0645 \u064a\u0628\u062f\u0623",
        "\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
        "\u0645\u0643\u062a\u0645\u0644",
        "\u064a\u062d\u062a\u0627\u062c \u0645\u0631\u0627\u062c\u0639\u0629"
      ],
      "default": "\u0644\u0645 \u064a\u0628\u062f\u0623",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0623\u062a\u0645\u062a\u0629"
    },
    "establishment_fee": {
      "type": "number",
      "title": "\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0623\u0633\u064a\u0633 (\u0631\u064a\u0627\u0644)"
    },
    "incubation_percentage": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0627\u062d\u062a\u0636\u0627\u0646 %"
    },
    "total_fee": {
      "type": "number",
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0631\u0633\u0648\u0645 (\u0631\u064a\u0627\u0644)"
    },
    "sian_ref": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0645\u0631\u062c\u0639 \u0633\u064a\u0627\u0646"
    },
    "incubator_activated": {
      "type": "boolean",
      "title": "\u062a\u0645 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062d\u0627\u0636\u0646\u0629",
      "default": false
    },
    "financial_integrated": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0627\u0644\u0631\u0628\u0637 \u0627\u0644\u0645\u0627\u0644\u064a",
      "default": false
    },
    "terms_accepted": {
      "type": "boolean",
      "title": "\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0645\u0642\u0628\u0648\u0644\u0629",
      "default": false
    },
    "provider_enabled": {
      "type": "boolean",
      "title": "\u0645\u0632\u0648\u062f \u0627\u0644\u062e\u062f\u0645\u0629 \u0645\u0641\u0639\u0651\u0644",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "company_name",
    "applicant_name",
    "email",
    "phone",
    "sector",
    "service_type"
  ]
}