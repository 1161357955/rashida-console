{
  "name": "\u0623\u062a\u0645\u062a\u0629 \u0645\u0639\u0627\u0644\u062c\u0629 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0629",
  "description": "\u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u0637\u0644\u0628 \u062e\u062f\u0645\u0629 \u062c\u062f\u064a\u062f \u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0645\u062d\u0631\u0643 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0627\u0644\u0643\u0627\u0645\u0644: \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0634\u0631\u0648\u0637\u060c \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0641\u064a \u0633\u064a\u0627\u0646\u060c \u0631\u0628\u0637 \u0627\u0644\u062d\u0627\u0636\u0646\u0629\u060c \u0648\u0627\u0644\u0631\u0628\u0637 \u0627\u0644\u0645\u0627\u0644\u064a.",
